{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/install-rtk.sh", "timeout": 120 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "command -v rtk >/dev/null 2>&1 && rtk hook claude || true" }
        ]
      }
    ]
  }
}
